{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@server/*": ["src/server/*"] },
    "noEmit": true
  },
  "include": ["src/server/**/*", "src/renderer/env.d.ts", "src/preload/**/*", "scripts/**/*", "src/shared/**/*", "tests/**/*", "*.config.ts", "*.config.mts"]
}
