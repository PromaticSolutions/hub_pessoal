{
  "name": "personal-task-hub",
  "productName": "Personal Task Hub",
  "version": "1.0.0",
  "description": "Central pessoal de tarefas, empresas e projetos",
  "main": "out/main/index.js",
  "private": true,
  "author": "solvusiotec",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "e2e": "npm run build && playwright test",
    "dist": "electron-vite build && electron-builder --linux dir"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "better-sqlite3": "12.11.1",
    "extract-zip": "2.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@types/archiver": "6.0.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "date-fns": "4.4.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.7",
    "recharts": "3.11.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
