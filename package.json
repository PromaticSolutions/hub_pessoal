{
  "name": "personal-task-hub",
  "productName": "Personal Task Hub",
  "version": "1.0.0",
  "description": "Central pessoal de tarefas, empresas e projetos",
  "private": true,
  "author": "solvusiotec",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "HUB_DEV_AUTH=1 VITE_DEV_AUTH=1 vite",
    "build": "node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "tsx --tsconfig tsconfig.node.json --import ./scripts/raw-loader.mjs scripts/db-migrate.ts",
    "import:sqlite": "tsx --tsconfig tsconfig.node.json --import ./scripts/raw-loader.mjs scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "better-sqlite3": "12.11.1",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.7",
    "recharts": "3.11.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
